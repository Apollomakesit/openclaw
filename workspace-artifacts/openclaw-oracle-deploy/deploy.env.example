# Local SSH settings
ORACLE_HOST=YOUR_ORACLE_PUBLIC_IP
ORACLE_USER=ubuntu
SSH_PRIVATE_KEY=$HOME/.ssh/id_ed25519

# Tailscale
TAILSCALE_AUTHKEY=tskey-auth-REPLACE_ME
TAILSCALE_HOSTNAME=openclaw

# OpenClaw gateway identity
OPENCLAW_HOSTNAME=openclaw

# OpenRouter
OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPENROUTER_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free

# WhatsApp channel
# 0 = skip WhatsApp setup
# 1 = install WhatsApp plugin and configure the channel
ENABLE_WHATSAPP=1
WHATSAPP_DM_POLICY=allowlist
WHATSAPP_ALLOW_FROM=+40769655124

# Memory mode
# 0 = strict-free local memory search only
# 1 = also install memory-lancedb with auto-capture + auto-recall
ENABLE_MEMORY_LANCEDB=1

# Optional for memory-lancedb
MEMORY_EMBEDDINGS_API_KEY=
MEMORY_EMBEDDINGS_MODEL=text-embedding-3-small
MEMORY_EMBEDDINGS_BASE_URL=
MEMORY_EMBEDDINGS_DIMENSIONS=
MEMORY_CAPTURE_MAX_CHARS=500
